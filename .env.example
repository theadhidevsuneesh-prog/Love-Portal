# --- Firebase web app config (Project settings > General > Your apps) ---
# These are public client identifiers, NOT secrets. Access is enforced by
# firestore.rules and storage.rules. Never put admin/service-account keys here.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# --- Love Assistant (server-side only, used by api/assistant.ts) ---
# Set these in your hosting provider's environment (e.g. Vercel). They are NOT
# prefixed with VITE_ so they are never bundled into the frontend.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
FIREBASE_WEB_API_KEY=
VITE_USE_EMULATORS=false
